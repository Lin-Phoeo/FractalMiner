<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(NativeReaderFramework)' == ''">net10.0</TargetFramework>
    <TargetFramework Condition="'$(NativeReaderFramework)' != ''">$(NativeReaderFramework)</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>../../Library/PackageCache/com.unity.nuget.newtonsoft-json@3.2.1/Runtime/Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Compile Include="Program.cs" />
    <Compile Include="../../Assets/EndfieldShaderPack/NativeCapturedDrawData.cs" Link="NativeCapturedDrawData.cs" />
  </ItemGroup>
</Project>
