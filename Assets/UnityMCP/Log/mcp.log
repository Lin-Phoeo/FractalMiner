{"ts":"2026-09-15T22:15:59.959Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":390,"action":"execute","params":{"action":"execute","code":"var outb = new System.Text.StringBuilder();\n// 检查当前渲染管线\nvar rp = UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline;\nvar rpAsset = UnityEngine.Rendering.GraphicsSettings.renderPipelineAsset;\noutb.AppendLine(\"currentRenderPipeline=\" + (rp != null ? rp.GetType().FullName : \"NULL\"));\noutb.AppendLine(\"renderPipelineAsset=\" + (rpAsset != null ? rpAsset.name + \" (\" + rpAsset.GetType().Name + \")\" : \"NULL\"));\n// 检查 shader 编译状态\nvar shader = UnityEngine.Shader.Find(\"Endfield/CharacterLit\");\noutb.AppendLine(\"shader=\" + (shader != null ? shader.name : \"NULL\") + \" passCount=\" + (shader != null ? shader.passCount : -1));\n// 检查材质实际 shader\nvar m = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(\"Assets/Typhoeus/Materials/M_actor_typhoea_body_01.mat\");\noutb.AppendLine(\"body_01 shader=\" + m.shader.name);\n// 检查 SkinnedMeshRenderer 实际渲染的材质和 shader\nvar srs = UnityEngine.Object.FindObjectsOfType<UnityEngine.SkinnedMeshRenderer>(true);\nint count = 0;\nforeach (var sr in srs) {\n    if (sr.sharedMaterial != null) {\n        if (sr.sharedMaterial.shader != null && sr.sharedMaterial.shader.name != \"Endfield/CharacterLit\") {\n            outb.AppendLine(\"  [异常] \" + sr.name + \" shader=\" + sr.sharedMaterial.shader.name);\n            count++;\n        }\n    }\n}\noutb.AppendLine(\"非 Endfield/CharacterLit 的 renderer 数=\" + count);\nreturn outb.ToString();","safety_checks":true,"compiler":"auto"}}
