{"ts":"2026-09-15T08:26:46.498Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":233,"action":"execute","params":{"action":"execute","code":"var m = GameObject.Find(\"Typhoeus\");\nvar sb = new System.Text.StringBuilder();\nforeach (var smr in m.GetComponentsInChildren<SkinnedMeshRenderer>()) {\n    string n = smr.name;\n    if (!n.Contains(\"body_01\") && !n.Contains(\"cloth_01\") && !n.Contains(\"hair_01\") && !n.Contains(\"face_01\") && !n.Contains(\"cloth_04\")) continue;\n    var mesh = smr.sharedMesh;\n    if (mesh == null) { sb.AppendLine(n+\" mesh=null\"); continue; }\n    var uv = mesh.uv;\n    float uMin=999,uMax=-999,vMin=999,vMax=-999;\n    for (int i=0;i<uv.Length;i++){ float x=uv[i].x,y=uv[i].y; if(x<uMin)uMin=x; if(x>uMax)uMax=x; if(y<vMin)vMin=y; if(y>vMax)vMax=y; }\n    var norms = mesh.normals;\n    Vector3 avg=Vector3.zero; for(int i=0;i<norms.Length;i++) avg+=norms[i];\n    if(norms.Length>0) avg/=norms.Length;\n    var tan = mesh.tangents;\n    sb.AppendLine(n+\" verts=\"+mesh.vertexCount+\" tris=\"+(mesh.triangles.Length/3)+\" uv=(\"+uMin.ToString(\"F1\")+\",\"+uMax.ToString(\"F1\")+\")x(\"+vMin.ToString(\"F1\")+\",\"+vMax.ToString(\"F1\")+\") avgNormal=(\"+avg.x.ToString(\"F2\")+\",\"+avg.y.ToString(\"F2\")+\",\"+avg.z.ToString(\"F2\")+\") tangents=\"+tan.Length);\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
