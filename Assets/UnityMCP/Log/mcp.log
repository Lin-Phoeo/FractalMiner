{"ts":"2026-09-16T19:29:54.345Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":279,"action":"execute","params":{"action":"execute","code":"var srs = UnityEngine.Object.FindObjectsOfType<UnityEngine.SkinnedMeshRenderer>(true);\nvar sb = new System.Text.StringBuilder();\nint total = 0, bad = 0;\nforeach (var sr in srs)\n{\n    if (!sr.gameObject.activeInHierarchy) continue;\n    total++;\n    var m = sr.sharedMesh;\n    if (m == null || sr.bones == null || sr.bones.Length == 0) { bad++; sb.AppendLine(sr.name + \" : no bones\"); continue; }\n    var bp = m.bindposes;\n    for (int i = 0; i < System.Math.Min(3, sr.bones.Length); i++)\n    {\n        if (sr.bones[i] == null) { bad++; sb.AppendLine(sr.name + \" : null bone[\" + i + \"]\"); break; }\n        var c = sr.bones[i].localToWorldMatrix * bp[i];\n        if (System.Math.Abs(c.m00 - 1.0) > 0.3 || System.Math.Abs(c.m11 - 1.0) > 0.3 || System.Math.Abs(c.m22 - 1.0) > 0.3)\n        { bad++; sb.AppendLine(sr.name + \" : bone[\" + i + \"] diag=\" + c.m00.ToString(\"F2\") + \",\" + c.m11.ToString(\"F2\") + \",\" + c.m22.ToString(\"F2\")); break; }\n    }\n}\nsb.AppendLine(\"result: \" + bad + \" bad / \" + total + \" total\");\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
