{"ts":"2026-09-16T19:32:24.076Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":189,"action":"execute","params":{"action":"execute","code":"var scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene();\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"scene = \" + scene.name + \" (\" + scene.path + \") dirty=\" + scene.isDirty);\nvar roots = scene.GetRootGameObjects();\nforeach (var r in roots)\n    sb.AppendLine(\"  ROOT: \" + r.name + \" active=\" + r.activeSelf);\nvar srs = UnityEngine.Object.FindObjectsOfType<UnityEngine.SkinnedMeshRenderer>(true);\nint activeSMR = 0;\nforeach (var sr in srs) if (sr.gameObject.activeInHierarchy) activeSMR++;\nsb.AppendLine(\"active SMR = \" + activeSMR + \" / \" + srs.Length);\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
