{"ts":"2026-09-15T21:59:00.250Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":363,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\n// 1. 保存当前场景\nbool saved = UnityEditor.SceneManagement.EditorSceneManager.SaveScene(UnityEngine.SceneManagement.SceneManager.GetActiveScene());\nsb.AppendLine(\"saveScene=\" + saved);\n// 2. 把 Typhoeus_Showcase 注册进 Build Settings\nUnityEditor.EditorBuildSettings.scenes = new UnityEditor.EditorBuildSettingsScene[] {\n    new UnityEditor.EditorBuildSettingsScene(\"Assets/Scenes/Typhoeus_Showcase.unity\", true)\n};\nsb.AppendLine(\"buildScenes registered: \" + UnityEditor.EditorBuildSettings.scenes.Length);\n// 3. 确认当前场景里的模型\nvar srs = UnityEngine.Object.FindObjectsOfType<UnityEngine.SkinnedMeshRenderer>(true);\nsb.AppendLine(\"SkinnedMeshRenderer=\" + srs.Length);\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
