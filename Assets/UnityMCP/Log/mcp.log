{"ts":"2026-09-15T22:09:14.531Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":297,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar mats = UnityEditor.AssetDatabase.FindAssets(\"t:Material\", new[]{\"Assets/Typhoeus/Materials\"});\nsb.AppendLine(\"材质总数=\" + mats.Length);\nint missingTex = 0;\nforeach (var g in mats) {\n    var p = UnityEditor.AssetDatabase.GUIDToAssetPath(g);\n    var m = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(p);\n    if (m == null) continue;\n    var texs = m.GetTexturePropertyNames();\n    foreach (var t in texs) {\n        var tex = m.GetTexture(t);\n        if (tex == null) {\n            // 只关心非空槽位？不，这里列出所有有名字但为 null 的\n        }\n    }\n    // 只检查关键纹理\n    string[] keys = new string[]{\"_BaseMap\",\"_BumpMap\",\"_DiffRampMap\",\"_ShadowLutTex\",\"_SpecRampMap\"};\n    foreach (var k in keys) {\n        if (!m.HasProperty(k)) continue;\n        var tex = m.GetTexture(k);\n        if (tex == null) { sb.AppendLine(m.name + \".\" + k + \" = NULL\"); missingTex++; }\n        else sb.AppendLine(m.name + \".\" + k + \" = \" + tex.name + \" (\" + tex.width + \"x\" + tex.height + \")\");\n    }\n}\nsb.AppendLine(\"缺失纹理槽位=\" + missingTex);\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
