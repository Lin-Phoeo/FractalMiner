{"ts":"2026-09-15T22:12:17.102Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":255,"action":"execute","params":{"action":"execute","code":"var outb = new System.Text.StringBuilder();\nstring[] matNames = new string[]{\"M_actor_typhoea_body_01\", \"M_actor_typhoea_cloth_01\", \"M_actor_typhoea_face_01\", \"M_actor_typhoea_hair_01\"};\nforeach (var mn in matNames) {\n    var m = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(\"Assets/Typhoeus/Materials/\" + mn + \".mat\");\n    outb.AppendLine(mn + \":\");\n    string[] keys = new string[]{\"_EnableVFXColorAdjustment\",\"_ColorAdjustmentRimIntensity\",\"_ColorAdjustmentRimWidth\",\"_ColorAdjustmentBrightness\",\"_ColorAdjustmentContrast\",\"_ColorAdjustmentSaturation\",\"_EnableStylizedFresnel\",\"_FakeFresnel\",\"_CharacterHeavyShadow\",\"_SkinRimOff\",\"_Smoothness\",\"_Specular\",\"_UseShadowLutTex\",\"_UseDiffRampMap\",\"_UseSpecRampMap\"};\n    foreach (var k in keys) {\n        if (m.HasProperty(k)) outb.AppendLine(\"  \" + k + \"=\" + m.GetFloat(k).ToString(\"F3\"));\n    }\n    var c = m.GetColor(\"_ColorAdjustmentRimColor\");\n    outb.AppendLine(\"  _ColorAdjustmentRimColor=(\" + c.r.ToString(\"F2\") + \",\" + c.g.ToString(\"F2\") + \",\" + c.b.ToString(\"F2\") + \",\" + c.a.ToString(\"F2\") + \")\");\n    var cc = m.GetColor(\"_ColorAdjustmentColorBlend\");\n    outb.AppendLine(\"  _ColorAdjustmentColorBlend=(\" + cc.r.ToString(\"F2\") + \",\" + cc.g.ToString(\"F2\") + \",\" + cc.b.ToString(\"F2\") + \",\" + cc.a.ToString(\"F2\") + \")\");\n}\nreturn outb.ToString();","safety_checks":true,"compiler":"auto"}}
