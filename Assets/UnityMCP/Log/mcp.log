{"ts":"2026-09-16T19:33:05.281Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":278,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar cam = UnityEngine.Camera.main;\nif (cam != null)\n{\n    sb.AppendLine(\"Main Camera pos=\" + cam.transform.position + \" rot=\" + cam.transform.eulerAngles);\n    // 模型 bounds\n    var srs = UnityEngine.Object.FindObjectsOfType<UnityEngine.SkinnedMeshRenderer>(true);\n    UnityEngine.Bounds total = default;\n    bool first = true;\n    foreach (var sr in srs)\n    {\n        if (!sr.gameObject.activeInHierarchy) continue;\n        var b = sr.bounds;\n        if (first) { total = b; first = false; } else total.Encapsulate(b);\n    }\n    sb.AppendLine(\"model world bounds center=\" + total.center + \" size=\" + total.size);\n    // 相机到模型距离\n    float dist = UnityEngine.Vector3.Distance(cam.transform.position, total.center);\n    sb.AppendLine(\"cam distance to model = \" + dist);\n    // 相机视野内可见性\n    var planes = UnityEngine.GeometryUtility.CalculateFrustumPlanes(cam);\n    bool visible = UnityEngine.GeometryUtility.TestPlanesAABB(planes, total);\n    sb.AppendLine(\"model in frustum = \" + visible);\n}\nelse sb.AppendLine(\"no main camera\");\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-16T19:33:05.401Z","tool":"get_tool_states","type":"resource","status":"SUCCESS","ms":6,"params":{}}
{"ts":"2026-09-16T19:33:22.682Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":247,"action":"execute","params":{"action":"execute","code":"var cam = UnityEngine.Camera.main;\nvar rt = UnityEngine.RenderTexture.GetTemporary(64, 64, 24, UnityEngine.RenderTextureFormat.ARGB32);\nvar prev = cam.targetTexture;\ncam.targetTexture = rt;\ncam.Render();\nUnityEngine.RenderTexture.active = rt;\nvar tex = new UnityEngine.Texture2D(64, 64, UnityEngine.TextureFormat.RGBA32, false);\ntex.ReadPixels(new UnityEngine.Rect(0,0,64,64), 0, 0);\ntex.Apply();\nvar c = tex.GetPixel(32, 32);\n// 采样多个点\nvar c1 = tex.GetPixel(32, 32);\nvar c2 = tex.GetPixel(40, 20);\nvar c3 = tex.GetPixel(20, 40);\nUnityEngine.RenderTexture.active = null;\ncam.targetTexture = prev;\nUnityEngine.RenderTexture.ReleaseTemporary(rt);\nUnityEngine.Object.DestroyImmediate(tex);\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"center pixel = \" + c1.r.ToString(\"F3\") + \",\" + c1.g.ToString(\"F3\") + \",\" + c1.b.ToString(\"F3\"));\nsb.AppendLine(\"pixel2 = \" + c2.r.ToString(\"F3\") + \",\" + c2.g.ToString(\"F3\") + \",\" + c2.b.ToString(\"F3\"));\nsb.AppendLine(\"pixel3 = \" + c3.r.ToString(\"F3\") + \",\" + c3.g.ToString(\"F3\") + \",\" + c3.b.ToString(\"F3\"));\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-16T19:33:22.793Z","tool":"get_tool_states","type":"resource","status":"SUCCESS","ms":3,"params":{}}
{"ts":"2026-09-16T19:33:40.376Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":224,"action":"execute","params":{"action":"execute","code":"var cam = UnityEngine.Camera.main;\nvar rt = UnityEngine.RenderTexture.GetTemporary(128, 128, 24, UnityEngine.RenderTextureFormat.ARGB32);\nvar prev = cam.targetTexture;\ncam.targetTexture = rt;\ncam.Render();\nUnityEngine.RenderTexture.active = rt;\nvar tex = new UnityEngine.Texture2D(128, 128, UnityEngine.TextureFormat.RGBA32, false);\ntex.ReadPixels(new UnityEngine.Rect(0,0,128,128), 0, 0);\ntex.Apply();\n// 模型 bounds 中心转屏幕坐标\nvar srs = UnityEngine.Object.FindObjectsOfType<UnityEngine.SkinnedMeshRenderer>(true);\nUnityEngine.Bounds total = default; bool first = true;\nforeach (var sr in srs) { if (!sr.gameObject.activeInHierarchy) continue; if(first){total=sr.bounds;first=false;} else total.Encapsulate(sr.bounds); }\nvar sp = cam.WorldToScreenPoint(total.center);\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"model center screen = \" + sp);\nint sx = (int)(sp.x / cam.pixelWidth * 128);\nint sy = (int)(sp.y / cam.pixelHeight * 128);\nsb.AppendLine(\"sample texcoord = \" + sx + \",\" + sy);\n// 采样模型中心附近 5x5 平均\nfloat r=0,g=0,b=0; int n=0;\nfor (int dy=-3; dy<=3; dy++) for (int dx=-3; dx<=3; dx++)\n{\n    int x = Math.Clamp(sx+dx,0,127); int y = Math.Clamp(sy+dy,0,127);\n    var c = tex.GetPixel(x,y); r+=c.r; g+=c.g; b+=c.b; n++;\n}\nsb.AppendLine(\"model region avg = \" + (r/n).ToString(\"F3\") + \",\" + (g/n).ToString(\"F3\") + \",\" + (b/n).ToString(\"F3\"));\nUnityEngine.RenderTexture.active = null;\ncam.targetTexture = prev;\nUnityEngine.RenderTexture.ReleaseTemporary(rt);\nUnityEngine.Object.DestroyImmediate(tex);\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-16T19:33:40.485Z","tool":"get_tool_states","type":"resource","status":"SUCCESS","ms":3,"params":{}}
{"ts":"2026-09-16T19:33:56.124Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":270,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nsb.AppendLine(\"_CharacterLightDir = \" + UnityEngine.Shader.GetGlobalVector(\"_CharacterLightDir\"));\nsb.AppendLine(\"_CharacterLightColor = \" + UnityEngine.Shader.GetGlobalVector(\"_CharacterLightColor\"));\nsb.AppendLine(\"_CharacterAmbient = \" + UnityEngine.Shader.GetGlobalVector(\"_CharacterAmbient\"));\n// 找 CharacterLight 组件并读字段\nvar gos = UnityEngine.Object.FindObjectsOfType<UnityEngine.GameObject>(true);\nforeach (var go in gos)\n{\n    if (go.name == \"CharacterLight\")\n    {\n        var comps = go.GetComponents<UnityEngine.Component>();\n        foreach (var c in comps)\n        {\n            if (c == null) continue;\n            var t = c.GetType();\n            sb.AppendLine(\"CharacterLight component: \" + t.FullName);\n            if (t.Name == \"EndfieldCharacterLight\")\n            {\n                var f = t.GetField(\"useSeparatedLight\", System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.Instance);\n                var lc = t.GetField(\"lightColor\", System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.Instance);\n                var ac = t.GetField(\"ambientColor\", System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.Instance);\n                var it = t.GetField(\"intensity\", System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.Instance);\n                if (f!=null) sb.AppendLine(\"  useSeparatedLight=\" + f.GetValue(c));\n                if (lc!=null) sb.AppendLine(\"  lightColor=\" + lc.GetValue(c));\n                if (ac!=null) sb.AppendLine(\"  ambientColor=\" + ac.GetValue(c));\n                if (it!=null) sb.AppendLine(\"  intensity=\" + it.GetValue(c));\n            }\n        }\n    }\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-16T19:33:56.246Z","tool":"get_tool_states","type":"resource","status":"SUCCESS","ms":4,"params":{}}
{"ts":"2026-09-16T19:34:20.145Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":203,"action":"execute","params":{"action":"execute","code":"var cam = UnityEngine.Camera.main;\nvar rt = UnityEngine.RenderTexture.GetTemporary(96, 96, 24, UnityEngine.RenderTextureFormat.ARGB32);\nvar prev = cam.targetTexture;\ncam.targetTexture = rt;\ncam.Render();\nUnityEngine.RenderTexture.active = rt;\nvar tex = new UnityEngine.Texture2D(96, 96, UnityEngine.TextureFormat.RGBA32, false);\ntex.ReadPixels(new UnityEngine.Rect(0,0,96,96), 0, 0);\ntex.Apply();\nvar sb = new System.Text.StringBuilder();\n// 采样 6x6 网格\nfor (int gy = 5; gy >= 0; gy--)\n{\n    string line = \"y=\" + gy + \" \";\n    for (int gx = 0; gx < 6; gx++)\n    {\n        int px = 16 + gx * 13;\n        int py = 16 + gy * 13;\n        var c = tex.GetPixel(px, py);\n        line += \"(\" + c.r.ToString(\"F1\") + \",\" + c.g.ToString(\"F1\") + \",\" + c.b.ToString(\"F1\") + \") \";\n    }\n    sb.AppendLine(line);\n}\nUnityEngine.RenderTexture.active = null;\ncam.targetTexture = prev;\nUnityEngine.RenderTexture.ReleaseTemporary(rt);\nUnityEngine.Object.DestroyImmediate(tex);\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-16T19:34:20.260Z","tool":"get_tool_states","type":"resource","status":"SUCCESS","ms":3,"params":{}}
{"ts":"2026-09-16T19:35:46.807Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":243,"action":"execute","params":{"action":"execute","code":"var m = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(\"Assets/Typhoeus/Materials/M_actor_typhoea_body_01.mat\");\nvar sb = new System.Text.StringBuilder();\n// 列出 body 材质的纹理属性\nsb.AppendLine(\"=== body_01 材质纹理 ===\");\nforeach (var pn in new string[]{\"_BaseMap\",\"_BumpMap\",\"_ShadowLutTex\",\"_DiffRampMap\",\"_SDFMask\",\"_SDFLightmap\"})\n{\n    var t = m.GetTexture(pn);\n    sb.AppendLine(pn + \" = \" + (t==null?\"NULL\":t.name));\n}\n// 采样 _BumpMap 中心像素\nvar bm = m.GetTexture(\"_BumpMap\") as UnityEngine.Texture2D;\nif (bm != null)\n{\n    var rt = UnityEngine.RenderTexture.GetTemporary(bm.width, bm.height, 0, UnityEngine.RenderTextureFormat.ARGB32);\n    UnityEngine.Graphics.Blit(bm, rt);\n    var prev = UnityEngine.RenderTexture.active;\n    UnityEngine.RenderTexture.active = rt;\n    var tex = new UnityEngine.Texture2D(bm.width, bm.height, UnityEngine.TextureFormat.RGBA32, false);\n    tex.ReadPixels(new UnityEngine.Rect(0,0,bm.width,bm.height),0,0);\n    tex.Apply();\n    var c = tex.GetPixel(bm.width/2, bm.height/2);\n    sb.AppendLine(\"_BumpMap center pixel = R=\" + c.r.ToString(\"F3\") + \" G=\" + c.g.ToString(\"F3\") + \" B=\" + c.b.ToString(\"F3\") + \" A=\" + c.a.ToString(\"F3\"));\n    // 采样几个角\n    var c2 = tex.GetPixel(2,2); var c3 = tex.GetPixel(bm.width-3, bm.height-3);\n    sb.AppendLine(\"corner1 = R=\" + c2.r.ToString(\"F3\") + \" G=\" + c2.g.ToString(\"F3\") + \" B=\" + c2.b.ToString(\"F3\") + \" A=\" + c2.a.ToString(\"F3\"));\n    sb.AppendLine(\"corner2 = R=\" + c3.r.ToString(\"F3\") + \" G=\" + c3.g.ToString(\"F3\") + \" B=\" + c3.b.ToString(\"F3\") + \" A=\" + c3.a.ToString(\"F3\"));\n    UnityEngine.RenderTexture.active = prev;\n    UnityEngine.RenderTexture.ReleaseTemporary(rt);\n    UnityEngine.Object.DestroyImmediate(tex);\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-16T19:35:46.924Z","tool":"get_tool_states","type":"resource","status":"SUCCESS","ms":3,"params":{}}
{"ts":"2026-09-16T19:36:32.212Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":230,"action":"execute","params":{"action":"execute","code":"var m = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(\"Assets/Typhoeus/Materials/M_actor_typhoea_body_01.mat\");\nvar bm = m.GetTexture(\"_BumpMap\") as UnityEngine.Texture2D;\nif (bm == null) return \"no bumpmap\";\nvar rt = UnityEngine.RenderTexture.GetTemporary(bm.width, bm.height, 0, UnityEngine.RenderTextureFormat.ARGB32);\nUnityEngine.Graphics.Blit(bm, rt);\nvar prev = UnityEngine.RenderTexture.active;\nUnityEngine.RenderTexture.active = rt;\nvar tex = new UnityEngine.Texture2D(bm.width, bm.height, UnityEngine.TextureFormat.RGBA32, false);\ntex.ReadPixels(new UnityEngine.Rect(0,0,bm.width,bm.height),0,0);\ntex.Apply();\nvar sb = new System.Text.StringBuilder();\n// 采样 9 点，看 R 通道是否恒 1\nint w = bm.width, h = bm.height;\nfloat minR=1, maxR=0, minA=1, maxA=0;\nfor (int gy=0; gy<3; gy++) for (int gx=0; gx<3; gx++)\n{\n    int px = gx*(w-1)/2, py = gy*(h-1)/2;\n    var c = tex.GetPixel(px,py);\n    minR = System.Math.Min(minR, c.r); maxR = System.Math.Max(maxR, c.r);\n    minA = System.Math.Min(minA, c.a); maxA = System.Math.Max(maxA, c.a);\n    sb.AppendLine(\"(\"+gx+\",\"+gy+\") R=\"+c.r.ToString(\"F3\")+\" G=\"+c.g.ToString(\"F3\")+\" B=\"+c.b.ToString(\"F3\")+\" A=\"+c.a.ToString(\"F3\"));\n}\nsb.AppendLine(\"R range = \" + minR.ToString(\"F3\") + \"..\" + maxR.ToString(\"F3\"));\nsb.AppendLine(\"A range = \" + minA.ToString(\"F3\") + \"..\" + maxA.ToString(\"F3\"));\nsb.AppendLine(\"tex size = \" + w + \"x\" + h + \" format=\" + bm.format);\nUnityEngine.RenderTexture.active = prev;\nUnityEngine.RenderTexture.ReleaseTemporary(rt);\nUnityEngine.Object.DestroyImmediate(tex);\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-16T19:36:32.327Z","tool":"get_tool_states","type":"resource","status":"SUCCESS","ms":4,"params":{}}
