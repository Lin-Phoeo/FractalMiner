{"ts":"2026-09-15T22:10:30.724Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":324,"action":"execute","params":{"action":"execute","code":"var outb = new System.Text.StringBuilder();\nstring[] matNames = new string[]{\"M_actor_typhoea_body_01\", \"M_actor_typhoea_cloth_01\", \"M_actor_typhoea_hair_01\", \"M_actor_typhoea_face_01\"};\nforeach (var mn in matNames) {\n    var m = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(\"Assets/Typhoeus/Materials/\" + mn + \".mat\");\n    if (m == null) { outb.AppendLine(mn + \" 材质NULL\"); continue; }\n    var tex = m.GetTexture(\"_BaseMap\") as UnityEngine.Texture2D;\n    if (tex == null) { outb.AppendLine(mn + \" _BaseMap NULL\"); continue; }\n    outb.AppendLine(mn + \" _BaseMap=\" + tex.name + \" size=\" + tex.width + \"x\" + tex.height + \" readable=\" + tex.isReadable + \" format=\" + tex.format);\n    // 尝试读中心像素\n    if (tex.isReadable) {\n        var c = tex.GetPixel(tex.width/2, tex.height/2);\n        outb.AppendLine(\"  中心像素 RGBA=(\" + c.r.ToString(\"F3\") + \",\" + c.g.ToString(\"F3\") + \",\" + c.b.ToString(\"F3\") + \",\" + c.a.ToString(\"F3\") + \")\");\n    }\n}\nreturn outb.ToString();","safety_checks":true,"compiler":"auto"}}
