{"ts":"2026-09-16T19:32:50.693Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":222,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\n// 1. shader 编译错误\nvar m = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(\"Assets/Typhoeus/Materials/M_actor_typhoea_body_01.mat\");\nvar sh = m.shader;\nvar msgs = UnityEditor.ShaderUtil.GetShaderMessages(sh);\nsb.AppendLine(\"shader=\" + sh.name + \" msgs=\" + msgs.Length);\nforeach (var msg in msgs) sb.AppendLine(\"  \" + msg.severity + \": \" + msg.message);\n// 2. URP 设置\nsb.AppendLine(\"Graphics RP = \" + (UnityEngine.Rendering.GraphicsSettings.defaultRenderPipeline==null?\"NULL\":UnityEngine.Rendering.GraphicsSettings.defaultRenderPipeline.name));\nsb.AppendLine(\"Quality RP = \" + (UnityEngine.QualitySettings.renderPipeline==null?\"NULL\":UnityEngine.QualitySettings.renderPipeline.name));\n// 3. 分离光照\nsb.AppendLine(\"_CharacterLightDir = \" + UnityEngine.Shader.GetGlobalVector(\"_CharacterLightDir\").ToString());\n// 4. 检查是否有重复/残留模型对象\nforeach (var r in UnityEngine.SceneManagement.SceneManager.GetActiveScene().GetRootGameObjects())\n{\n    var srs = r.GetComponentsInChildren<UnityEngine.SkinnedMeshRenderer>(true);\n    if (srs.Length > 0) sb.AppendLine(\"ROOT has SMR: \" + r.name + \" active=\" + r.activeSelf + \" smrCount=\" + srs.Length);\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
