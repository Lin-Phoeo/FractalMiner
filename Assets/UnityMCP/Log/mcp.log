{"ts":"2026-09-16T19:07:15.337Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":301,"action":"execute","params":{"action":"execute","code":"var srs = UnityEngine.Object.FindObjectsOfType<UnityEngine.SkinnedMeshRenderer>(true);\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"total SMR: \" + srs.Length);\nforeach (var sr in srs)\n{\n    var m = sr.sharedMesh;\n    if (m == null) { sb.AppendLine(sr.name + \" : mesh=NULL\"); continue; }\n    sb.AppendLine(sr.name + \" | verts=\" + m.vertexCount + \" | bounds=\" + m.bounds.center + \" size=\" + m.bounds.size + \" | bones=\" + (sr.bones==null?0:sr.bones.Length) + \" | rootBone=\" + (sr.rootBone==null?\"NULL\":sr.rootBone.name));\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
