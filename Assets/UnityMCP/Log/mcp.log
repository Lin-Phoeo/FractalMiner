{"ts":"2026-09-15T22:15:00.502Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":279,"action":"execute","params":{"action":"execute","code":"var outb = new System.Text.StringBuilder();\n// 禁用 EndfieldCharacterLight 组件，防止覆盖光照变量\nvar cl = GameObject.Find(\"CharacterLight\");\nvar lightComp = cl != null ? cl.GetComponent<UnityEngine.MonoBehaviour>() : null;\nif (lightComp != null) lightComp.enabled = false;\n// 设置极端光照：纯红光照，纯黑环境\nUnityEngine.Shader.SetGlobalVector(\"_CharacterLightDir\", new UnityEngine.Vector4(0,1,0,1));\nUnityEngine.Shader.SetGlobalVector(\"_CharacterLightColor\", new UnityEngine.Vector4(1,0,0,1));\nUnityEngine.Shader.SetGlobalVector(\"_CharacterAmbient\", new UnityEngine.Vector4(0,0,0,1));\nvar cam = UnityEngine.Camera.main;\nint W=160, H=90;\nvar rt = new UnityEngine.RenderTexture(W,H,24);\ncam.targetTexture = rt;\ncam.Render();\nUnityEngine.RenderTexture.active = rt;\nvar tex = new UnityEngine.Texture2D(W,H,UnityEngine.TextureFormat.RGB24,false);\ntex.ReadPixels(new UnityEngine.Rect(0,0,W,H),0,0);\ntex.Apply();\ncam.targetTexture = null;\nUnityEngine.RenderTexture.active = null;\nvar cs = tex.GetPixels();\nfloat sumR=0,sumG=0,sumB=0; int charPx=0;\nfor (int i=0;i<cs.Length;i++) {\n    var c = cs[i];\n    if (c.b > c.r + 0.05f && c.b > 0.6f) continue;\n    if (c.r < 0.15f && c.g < 0.15f) continue;\n    if (Mathf.Abs(c.r-c.g) < 0.03f && Mathf.Abs(c.g-c.b) < 0.03f && c.r < 0.5f) continue;\n    sumR+=c.r; sumG+=c.g; sumB+=c.b; charPx++;\n}\noutb.AppendLine(\"纯红光照后 角色平均RGB=(\" + (charPx>0?(sumR/charPx).ToString(\"F2\"):\"-\") + \",\" + (charPx>0?(sumG/charPx).ToString(\"F2\"):\"-\") + \",\" + (charPx>0?(sumB/charPx).ToString(\"F2\"):\"-\") + \")\");\n// 恢复组件\nif (lightComp != null) lightComp.enabled = true;\nUnityEngine.Object.DestroyImmediate(tex);\nUnityEngine.Object.DestroyImmediate(rt);\nreturn outb.ToString();","safety_checks":true,"compiler":"auto"}}
