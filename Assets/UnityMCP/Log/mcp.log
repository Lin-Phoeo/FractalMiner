{"ts":"2026-09-16T19:29:00.750Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":268,"action":"execute","params":{"action":"execute","code":"var srs = UnityEngine.Object.FindObjectsOfType<UnityEngine.SkinnedMeshRenderer>(true);\nvar sb = new System.Text.StringBuilder();\n// 只检查当前 active 层级里的 SMR 的骨骼匹配\nforeach (var sr in srs)\n{\n    if (!sr.gameObject.activeInHierarchy) continue;\n    var m = sr.sharedMesh;\n    if (m == null || sr.bones == null || sr.bones.Length == 0) { sb.AppendLine(sr.name + \" : no bones\"); continue; }\n    var bp = m.bindposes;\n    int bad = 0;\n    for (int i = 0; i < System.Math.Min(3, sr.bones.Length); i++)\n    {\n        if (sr.bones[i] == null) { bad++; continue; }\n        var combined = sr.bones[i].localToWorldMatrix * bp[i];\n        float d0 = combined.m00, d1 = combined.m11, d2 = combined.m22;\n        if (System.Math.Abs(d0 - 1.0) > 0.3 || System.Math.Abs(d1 - 1.0) > 0.3 || System.Math.Abs(d2 - 1.0) > 0.3) bad++;\n    }\n    if (bad > 0) sb.AppendLine(\"BAD  \" + sr.name + \" (bones=\" + sr.bones.Length + \")\");\n}\nreturn sb.Length == 0 ? \"ALL SMR bone matrices OK\" : sb.ToString();","safety_checks":true,"compiler":"auto"}}
