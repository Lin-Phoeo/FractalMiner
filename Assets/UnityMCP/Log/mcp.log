{"ts":"2026-09-15T22:04:03.919Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":411,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\n// 1. 检查编译状态\nsb.AppendLine(\"isCompiling=\" + UnityEditor.EditorApplication.isCompiling);\n// 2. 尝试加载 Assembly-CSharp\nvar asmCS = System.AppDomain.CurrentDomain.GetAssemblies().FirstOrDefault(a => a.GetName().Name == \"Assembly-CSharp\");\nsb.AppendLine(\"Assembly-CSharp loaded=\" + (asmCS != null));\nif (asmCS != null) {\n    var t = asmCS.GetType(\"Endfield.EndfieldCharacterLight\");\n    sb.AppendLine(\"Endfield.EndfieldCharacterLight type=\" + (t != null ? t.FullName : \"NULL\"));\n}\n// 3. 检查所有已加载程序集（含 Unity 的）\nforeach (var a in System.AppDomain.CurrentDomain.GetAssemblies()) {\n    var n = a.GetName().Name;\n    if (n != null && (n.Contains(\"Assembly\") || n.Contains(\"Endfield\") || n.Contains(\"Smooth\"))) sb.AppendLine(\"ASM: \" + n);\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
