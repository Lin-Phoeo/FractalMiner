{"ts":"2026-09-15T22:07:38.438Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":301,"action":"execute","params":{"action":"execute","code":"var cam = UnityEngine.Camera.main;\nint W=80, H=44;\nvar rt = new UnityEngine.RenderTexture(W,H,24);\ncam.targetTexture = rt;\ncam.Render();\nUnityEngine.RenderTexture.active = rt;\nvar tex = new UnityEngine.Texture2D(W,H,UnityEngine.TextureFormat.RGB24,false);\ntex.ReadPixels(new UnityEngine.Rect(0,0,W,H),0,0);\ntex.Apply();\ncam.targetTexture = null;\nUnityEngine.RenderTexture.active = null;\nvar cs = tex.GetPixels();\nstring ramp = \" .:-=+*#%@\";\nvar sb = new System.Text.StringBuilder();\nfloat sumL=0; int n=cs.Length; float minL=1, maxL=0;\nfor(int y=H-1;y>=0;y--){\n  for(int x=0;x<W;x++){\n    var c=cs[y*W+x]; float l=(c.r+c.g+c.b)/3f;\n    sumL+=l; if(l<minL)minL=l; if(l>maxL)maxL=l;\n    int idx=(int)(l*9.999f); if(idx>9)idx=9;\n    sb.Append(ramp[idx]);\n  }\n  sb.AppendLine();\n}\nUnityEngine.Object.DestroyImmediate(tex);\nUnityEngine.Object.DestroyImmediate(rt);\nsb.AppendLine(\"avgL=\"+(sumL/n).ToString(\"F3\")+\" minL=\"+minL.ToString(\"F3\")+\" maxL=\"+maxL.ToString(\"F3\"));\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
