{"ts":"2026-09-15T22:09:33.495Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":327,"action":"execute","params":{"action":"execute","code":"var cam = UnityEngine.Camera.main;\nint W=160, H=90;\nvar rt = new UnityEngine.RenderTexture(W,H,24);\ncam.targetTexture = rt;\ncam.Render();\nUnityEngine.RenderTexture.active = rt;\nvar tex = new UnityEngine.Texture2D(W,H,UnityEngine.TextureFormat.RGB24,false);\ntex.ReadPixels(new UnityEngine.Rect(0,0,W,H),0,0);\ntex.Apply();\ncam.targetTexture = null;\nUnityEngine.RenderTexture.active = null;\nvar cs = tex.GetPixels();\nvar outb = new System.Text.StringBuilder();\nstring[] labels = new string[]{\"头顶头发\", \"脸\", \"身体上\", \"身体中\", \"身体下衣服\", \"地面\"};\nint[,] regions = new int[,]{\n  {20,60, 50,70},\n  {40,52, 30,60},\n  {55,50, 40,75},\n  {70,40, 40,85},\n  {85,30, 40,85},\n  {100,10, 30,90}\n};\nfor (int r=0;r<regions.GetLength(0);r++) {\n    int x1=regions[r,0], x2=regions[r,1], y1=regions[r,2], y2=regions[r,3];\n    float sumR=0,sumG=0,sumB=0; int cnt=0;\n    for (int y=y1;y<y2;y++) for (int x=x1;x<x2;x++) { var c=cs[y*W+x]; sumR+=c.r; sumG+=c.g; sumB+=c.b; cnt++; }\n    outb.AppendLine(labels[r] + \" RGB=(\" + (sumR/cnt).ToString(\"F2\") + \",\" + (sumG/cnt).ToString(\"F2\") + \",\" + (sumB/cnt).ToString(\"F2\") + \")\");\n}\nUnityEngine.Object.DestroyImmediate(tex);\nUnityEngine.Object.DestroyImmediate(rt);\nreturn outb.ToString();","safety_checks":true,"compiler":"auto"}}
