{"ts":"2026-09-15T22:13:58.108Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":213,"action":"execute","params":{"action":"execute","code":"var outb = new System.Text.StringBuilder();\nvar m = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(\"Assets/Typhoeus/Materials/M_actor_typhoea_body_01.mat\");\n// 采样多个纹理\nstring[] texKeys = new string[]{\"_BaseMap\",\"_DiffRampMap\",\"_ShadowLutTex\"};\nforeach (var k in texKeys) {\n    var tex = m.GetTexture(k) as UnityEngine.Texture2D;\n    if (tex == null) { outb.AppendLine(k + \" = NULL\"); continue; }\n    int sw = 4, sh = 4;\n    var rt = UnityEngine.RenderTexture.GetTemporary(sw, sh, 0, UnityEngine.RenderTextureFormat.ARGB32);\n    UnityEngine.Graphics.Blit(tex, rt);\n    var prev = UnityEngine.RenderTexture.active;\n    UnityEngine.RenderTexture.active = rt;\n    var rtex = new UnityEngine.Texture2D(sw, sh, UnityEngine.TextureFormat.RGBA32, false);\n    rtex.ReadPixels(new UnityEngine.Rect(0,0,sw,sh), 0, 0);\n    rtex.Apply();\n    UnityEngine.RenderTexture.active = prev;\n    UnityEngine.RenderTexture.ReleaseTemporary(rt);\n    var c = rtex.GetPixel(2, 2);\n    outb.AppendLine(k + \" (\" + tex.name + \" \" + tex.width + \"x\" + tex.height + \") 中心 RGBA=(\" + c.r.ToString(\"F2\") + \",\" + c.g.ToString(\"F2\") + \",\" + c.b.ToString(\"F2\") + \",\" + c.a.ToString(\"F2\") + \")\");\n    UnityEngine.Object.DestroyImmediate(rtex);\n}\nreturn outb.ToString();","safety_checks":true,"compiler":"auto"}}
