{"ts":"2026-09-16T19:05:19.456Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1396,"action":"execute","params":{"action":"execute","code":"var gos = UnityEngine.Object.FindObjectsOfType<UnityEngine.GameObject>(true);\nvar sb = new System.Text.StringBuilder();\nforeach (var go in gos)\n{\n    var comps = go.GetComponents<UnityEngine.Component>();\n    foreach (var c in comps)\n        if (c == null) { sb.AppendLine(\"MISSING SCRIPT on: \" + go.name); break; }\n}\nvar ldir = UnityEngine.Shader.GetGlobalVector(\"_CharacterLightDir\");\nsb.AppendLine(\"_CharacterLightDir=\" + ldir.ToString());\nreturn sb.Length == 0 ? \"clean\" : sb.ToString();","safety_checks":true,"compiler":"auto"}}
