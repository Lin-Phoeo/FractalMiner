{"ts":"2026-09-16T19:32:34.738Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":302,"action":"execute","params":{"action":"execute","code":"var srs = UnityEngine.Object.FindObjectsOfType<UnityEngine.SkinnedMeshRenderer>(true);\nvar sb = new System.Text.StringBuilder();\nint bad = 0, total = 0;\nforeach (var sr in srs)\n{\n    if (!sr.gameObject.activeInHierarchy) continue;\n    total++;\n    var m = sr.sharedMesh;\n    if (m == null) { sb.AppendLine(sr.name + \" mesh=NULL\"); bad++; continue; }\n    if (sr.bones == null || sr.bones.Length == 0) { sb.AppendLine(sr.name + \" bones=0\"); bad++; continue; }\n    var bp = m.bindposes;\n    bool thisBad = false;\n    for (int i = 0; i < System.Math.Min(4, sr.bones.Length); i++)\n    {\n        if (sr.bones[i] == null) { thisBad = true; sb.AppendLine(sr.name + \" null bone[\" + i + \"]\"); break; }\n        var c = sr.bones[i].localToWorldMatrix * bp[i];\n        if (System.Math.Abs(c.m00-1) > 0.3 || System.Math.Abs(c.m11-1) > 0.3 || System.Math.Abs(c.m22-1) > 0.3)\n        { thisBad = true; sb.AppendLine(sr.name + \" bone[\" + i + \"] \" + sr.bones[i].name + \" diag=\" + c.m00.ToString(\"F2\")+\",\"+c.m11.ToString(\"F2\")+\",\"+c.m22.ToString(\"F2\")); break; }\n    }\n    if (thisBad) bad++;\n}\nsb.AppendLine(\"RESULT: \" + bad + \" bad / \" + total + \" total\");\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
