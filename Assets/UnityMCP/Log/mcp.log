{"ts":"2026-09-15T22:10:51.587Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":240,"action":"execute","params":{"action":"execute","code":"var outb = new System.Text.StringBuilder();\nstring[] matNames = new string[]{\"M_actor_typhoea_body_01\", \"M_actor_typhoea_cloth_01\", \"M_actor_typhoea_hair_01\"};\nforeach (var mn in matNames) {\n    var m = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(\"Assets/Typhoeus/Materials/\" + mn + \".mat\");\n    var tex = m.GetTexture(\"_BaseMap\") as UnityEngine.Texture2D;\n    // 用 Blit 采样纹理中心区域到可读 RT\n    var rt = UnityEngine.RenderTexture.GetTemporary(8, 8, 0, UnityEngine.RenderTextureFormat.ARGB32);\n    UnityEngine.Graphics.Blit(tex, rt);\n    var prev = UnityEngine.RenderTexture.active;\n    UnityEngine.RenderTexture.active = rt;\n    var rtex = new UnityEngine.Texture2D(8, 8, UnityEngine.TextureFormat.RGBA32, false);\n    rtex.ReadPixels(new UnityEngine.Rect(0,0,8,8), 0, 0);\n    rtex.Apply();\n    UnityEngine.RenderTexture.active = prev;\n    UnityEngine.RenderTexture.ReleaseTemporary(rt);\n    var c = rtex.GetPixel(4, 4);\n    outb.AppendLine(mn + \" _BaseMap 中心颜色 RGBA=(\" + c.r.ToString(\"F2\") + \",\" + c.g.ToString(\"F2\") + \",\" + c.b.ToString(\"F2\") + \",\" + c.a.ToString(\"F2\") + \")\");\n    UnityEngine.Object.DestroyImmediate(rtex);\n}\nreturn outb.ToString();","safety_checks":true,"compiler":"auto"}}
