{"ts":"2026-09-15T22:03:41.299Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":212,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\n// 1. 检查全局 shader 光照变量\nvar dir = UnityEngine.Shader.GetGlobalVector(\"_CharacterLightDir\");\nvar col = UnityEngine.Shader.GetGlobalVector(\"_CharacterLightColor\");\nvar amb = UnityEngine.Shader.GetGlobalVector(\"_CharacterAmbient\");\nsb.AppendLine(\"_CharacterLightDir = (\" + dir.x.ToString(\"F3\") + \",\" + dir.y.ToString(\"F3\") + \",\" + dir.z.ToString(\"F3\") + \",\" + dir.w.ToString(\"F3\") + \")\");\nsb.AppendLine(\"_CharacterLightColor = (\" + col.x.ToString(\"F3\") + \",\" + col.y.ToString(\"F3\") + \",\" + col.z.ToString(\"F3\") + \",\" + col.w.ToString(\"F3\") + \")\");\nsb.AppendLine(\"_CharacterAmbient = (\" + amb.x.ToString(\"F3\") + \",\" + amb.y.ToString(\"F3\") + \",\" + amb.z.ToString(\"F3\") + \",\" + amb.w.ToString(\"F3\") + \")\");\n// 2. 检查 CharacterLight 对象\nvar cl = GameObject.Find(\"CharacterLight\");\nif (cl != null) {\n    var comps = cl.GetComponents<UnityEngine.Component>();\n    foreach (var c in comps) {\n        if (c == null) sb.AppendLine(\"CharacterLight 组件: NULL (Missing Script!)\");\n        else sb.AppendLine(\"CharacterLight 组件: \" + c.GetType().FullName);\n    }\n} else sb.AppendLine(\"CharacterLight 对象不存在!\");\n// 3. 检查场景主光\nvar lights = UnityEngine.Object.FindObjectsOfType<UnityEngine.Light>(true);\nforeach (var l in lights) sb.AppendLine(\"Light: \" + l.name + \" type=\" + l.type + \" intensity=\" + l.intensity + \" dir=\" + l.transform.forward);\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
